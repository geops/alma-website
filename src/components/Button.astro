---
interface Props {
  class?: string;
  disabled?: boolean;
  href: string;
  outline?: boolean;
  target?: string;
}
---

<a
  aria-disabled={Astro.props.disabled ? "true" : "false"}
  href={Astro.props.href}
  target={Astro.props.target}
  class={`flex items-center gap-2 px-6 py-3 rounded-4xl justify-center font-medium transition-colors ${Astro.props.outline ? "border border-blue-600 text-blue-600 hover:bg-blue-600 hover:text-white" : "bg-blue-600 hover:bg-blue-700 text-white aria-disabled:bg-gray-400 aria-disabled:text-gray-550 aria-disabled:pointer-events-none"} ${Astro.props.class ?? ""}`}
>
  <slot />
</a>
