---
import { Image } from "astro:assets";

import Button from "./Button.astro";
import AlmaLogo from "./graphics/AlmaLogo.svg";
import AlmaName from "./graphics/AlmaName.svg";
import Background from "./graphics/Background.svg";
import LinkIcon from "./icons/LinkIcon.svg";
import HeaderImage from "./images/header.png";
import { useTranslations } from "../lib.ts";

const t = useTranslations(Astro.currentLocale);
---

<header class="relative overflow-hidden">
  <Background class="absolute top-0 -left-96 -z-10 md:left-0" />
  <div
    class="container mx-auto grid grid-cols-1 items-center gap-4 px-4 md:grid-cols-2 md:gap-8 md:pb-12 lg:px-8 xl:pb-16"
  >
    <div class="max-w-sm space-y-5 pt-32 md:max-w-md md:pt-40 xl:pt-48">
      <div class="flex items-center gap-1">
        <AlmaLogo class="h-7" />
        <AlmaName class="h-7" />
      </div>
      <h1>{t("header.heading")}</h1>
      <p class="md:text-xl" set:html={t("header.description")} />
      <Button
        class="hidden w-50 lg:flex"
        href="https://demo.alma-os.ch/auth/realms/alma/protocol/openid-connect/auth?response_type=code&client_id=alma-backend&redirect_uri=https%3A%2F%2Fdemo.alma-os.ch%2Fapi%2Fauth%2Fcallback%2F&username=test@alma-os.ch&password=demo2024"
        target="demo"
      >
        <LinkIcon />
        {t("header.demoLink")}
      </Button>
      <div
        class="flex w-60 flex-col space-y-2.5 rounded-4xl border border-gray-400 bg-gray-100 p-4 lg:hidden"
      >
        <Button disabled href="#" target="demo">
          <LinkIcon />
          {t("header.demoLink")}
        </Button>
        <p class="text-sm" set:html={t("header.demoHintDesktop")} />
      </div>
    </div>
    <Image class="w-full" src={HeaderImage} alt={t("header.heading")} />
  </div>
</header>
